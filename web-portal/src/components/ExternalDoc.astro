---
import { marked } from 'marked';
import { getDocEntryById, loadDocContent } from '../lib/registry.js';

const { docId } = Astro.props;
const entry = getDocEntryById(docId);
const rawContent = loadDocContent(entry);
const contentHtml = rawContent ? marked.parse(rawContent) : '';
---

{entry ? (
  <article>
    <header>
      <h1>{entry.title ?? docId}</h1>
      <p>
        <strong>{entry.doc_id}</strong>
        {entry.doc_type && <>
          {' '}· {entry.doc_type}
        </>}
        {entry.status && <>
          {' '}· {entry.status}
        </>}
      </p>
      {entry.summary && <p>{entry.summary}</p>}
    </header>

    {contentHtml ? (
      <div set:html={contentHtml} />
    ) : (
      <p>Content could not be loaded for this document.</p>
    )}
  </article>
) : (
  <p>Document not found in registry.</p>
)}
