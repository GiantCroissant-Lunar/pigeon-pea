---
const { title = 'Pigeon Pea Docs' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <header style="padding: 1rem; border-bottom: 1px solid #e5e7eb;">
      <nav style="display: flex; gap: 1rem; align-items: baseline;">
        <a href="/" style="font-weight: 600;">Pigeon Pea Docs</a>
        <a href="/docs/">All docs</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main style="max-width: 960px; margin: 0 auto; padding: 1.5rem 1rem 3rem;">
      <slot />
    </main>
  </body>
</html>
