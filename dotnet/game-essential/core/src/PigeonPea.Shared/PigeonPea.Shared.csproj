<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ECS Framework -->
    <PackageReference Include="Arch" Version="2.0.0" />

    <!-- Roguelike Algorithms & Utilities -->
    <PackageReference Include="GoRogue" Version="3.0.0-beta10" />
    <PackageReference Include="TheSadRogue.Primitives" Version="1.6.0-rc3" />

    <!-- Rendering: Skia backend for SkiaMapRasterizer -->
    <PackageReference Include="SkiaSharp" Version="2.88.7" />

    <!-- Utilities -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Reactive Programming -->
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
    <PackageReference Include="MessagePipe" Version="1.8.0" />
    <PackageReference Include="ObservableCollections" Version="3.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <PackageReference Include="Stateless" Version="5.17.0" />

    <!-- Source Generators -->
    <PackageReference Include="Plate.SCG.Shared.Attributes" Version="0.1.0" />
    <PackageReference Include="Plate.SCG.General.DisposePattern" Version="0.1.0" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PigeonPea.Game.Contracts/PigeonPea.Game.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\app-essential\core\src\PigeonPea.Contracts\PigeonPea.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\_lib\fantasy-map-generator-port\src\FantasyMapGenerator.Core\FantasyMapGenerator.Core.csproj" />
    <ProjectReference Include="..\..\..\..\engine\core\src\PigeonPea.Shared.Rendering\PigeonPea.Shared.Rendering.csproj" />
    <ProjectReference Include="..\PigeonPea.Dungeon.Core\PigeonPea.Dungeon.Core.csproj" />
  </ItemGroup>

  <!-- Use rendering primitives from PigeonPea.Shared.Rendering instead of local duplicates -->
  <ItemGroup>
    <Compile Remove="Rendering\IRenderTarget.cs" />
    <Compile Remove="Rendering\IRenderer.cs" />
    <Compile Remove="Rendering\RendererCapabilities.cs" />
    <Compile Remove="Rendering\Tile.cs" />
    <Compile Remove="Rendering\TileFlags.cs" />
    <Compile Remove="Rendering\Viewport.cs" />
  </ItemGroup>

</Project>
