<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PigeonPea.Game.Input</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>PigeonPea.Game.Input</PackageId>
    <Version>0.1.0</Version>
    <Authors>Pigeon Pea Development Team</Authors>
    <Description>Platform-specific input integration for PigeonPea game engine</Description>
    <PackageTags>gamedev;input;controls;console</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="..\..\..\..\app-essential\core\src\PigeonPea.Shared.Input\PigeonPea.Shared.Input.csproj" />
    <ProjectReference Include="..\PigeonPea.Shared\PigeonPea.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet Packages -->
    <PackageReference Include="MessagePipe" Version="1.8.1" />
    <PackageReference Include="TheSadRogue.Primitives" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Resources for Input Actions -->
    <EmbeddedResource Include="Assets\*.inputactions" />
  </ItemGroup>

</Project>
