<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PigeonPea.Shared.Perception</RootNamespace>
    <AssemblyName>PigeonPea.Shared.Perception</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>PigeonPea.Shared.Perception</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Immutable Collections for WorldState and other immutable data structures -->
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

</Project>
