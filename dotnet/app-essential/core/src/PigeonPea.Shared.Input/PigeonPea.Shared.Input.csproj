<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PigeonPea.Shared.Input</RootNamespace>
    <AssemblyName>PigeonPea.Shared.Input</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON Serialization -->
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse existing input source files during migration -->
    <Compile Include="..\..\..\..\engine\core\src\PigeonPea.Input.Core\**\*.cs" />
  </ItemGroup>

</Project>
