<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Terminal.Gui v2 for Console HUD -->
    <PackageReference Include="Terminal.Gui" Version="2.0.0" />

    <!-- System.CommandLine for CLI argument parsing -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-rc.2.25502.107" />

    <!-- Configuration support -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />

    <!-- Image encoding for iTerm2 graphics renderer -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- Terminal Graphics Support -->
    <!-- Note: For Sixel/Kitty/Braille, we'll implement custom renderers -->
    <!-- using ANSI escape sequences and terminal capabilities -->

    <!-- Source Generators -->
    <PackageReference Include="Plate.SCG.Shared.Attributes" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy configuration files to output -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include HUD entrypoint living at console-app/TerminalHudApplication.cs -->
    <Compile Include="..\..\..\TerminalHudApplication.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Shared Game Logic -->
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Shared\PigeonPea.Shared.csproj" />

    <!-- Plugin System -->
    <ProjectReference Include="..\..\..\..\app-essential\core\src\PigeonPea.PluginSystem\PigeonPea.PluginSystem.csproj" />

    <!-- Game Contracts for IRenderer -->
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Game.Contracts\PigeonPea.Game.Contracts.csproj" />

    <!-- Map rendering + tile pipeline (content rendering) -->
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Map.Core\PigeonPea.Map.Core.csproj" />
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Map.Control\PigeonPea.Map.Control.csproj" />
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Map.Rendering\PigeonPea.Map.Rendering.csproj" />
    <ProjectReference Include="..\..\..\..\engine\core\src\PigeonPea.Shared.Rendering\PigeonPea.Shared.Rendering.csproj" />
    <ProjectReference Include="..\..\..\..\content-authoring\core\src\PigeonPea.Content.Rendering\PigeonPea.Content.Rendering.csproj" />

    <!-- Dungeon core/control/rendering for DungeonPanelView -->
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Dungeon.Core\PigeonPea.Dungeon.Core.csproj" />
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Dungeon.Control\PigeonPea.Dungeon.Control.csproj" />
    <ProjectReference Include="..\..\..\..\game-essential\core\src\PigeonPea.Dungeon.Rendering\PigeonPea.Dungeon.Rendering.csproj" />
  </ItemGroup>

</Project>
