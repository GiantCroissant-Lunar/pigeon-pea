{
  "PluginSystem": {
    "Profile": "dotnet.console",
    "PluginPaths": ["plugins", "../plugins"],
    "HotReload": false,
    "SharedAssemblies": [
      "PigeonPea.Contracts",
      "PigeonPea.Game.Contracts",
      "PigeonPea.Dungeon.Contracts",
      "PigeonPea.Rendering.Contracts",
      "PigeonPea.Shared",
      "PigeonPea.Shared.Inventory",
      "PigeonPea.Game.Inventory",
      "Arch"
    ]
  },
  "Game": {
    "Renderer": "plugin-hud",
    "DungeonGen": "modern-edgar"
  },
  "DungeonSystem": {
    "UseNewPluginArchitecture": true,
    "GeneratorPluginId": "dungeon-generator-modern-edgar"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "PigeonPea": "Information"
    }
  }
}
