<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Terminal.Gui v2 for Console HUD -->
    <PackageReference Include="Terminal.Gui" />

    <!-- System.CommandLine for CLI argument parsing -->
    <PackageReference Include="System.CommandLine" />

    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Scrutor" />
    <!-- Image encoding for iTerm2 graphics renderer -->
    <PackageReference Include="SixLabors.ImageSharp" />

    <!-- Terminal Graphics Support -->
    <!-- Note: For Sixel/Kitty/Braille, we'll implement custom renderers -->
    <!-- using ANSI escape sequences and terminal capabilities -->

    <!-- Source Generators -->
    <PackageReference Include="Plate.SCG.Shared.Attributes" />
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy configuration files to output -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\configs\scales.json" CopyToOutputDirectory="PreserveNewest" Link="scales.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include HUD entrypoint living at console-app/TerminalHudApplication.cs -->
    <Compile Update="TerminalHudApplication.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Shared Game Logic -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\shared\PigeonPea.Shared\PigeonPea.Shared.csproj" />

    <!-- Plugin System -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\app-essential\core\src\PigeonPea.PluginSystem\PigeonPea.PluginSystem.csproj" />

    <!-- Config/input contracts and plugin so their outputs are copied into this console's plugins folder -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\app-essential\contracts\src\PigeonPea.Config.Contracts\PigeonPea.Config.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\app-essential\contracts\src\PigeonPea.Input.Contracts\PigeonPea.Input.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\app-essential\plugins\src\PigeonPea.Plugins.Config\PigeonPea.Plugins.Config.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <!-- Game Contracts for IRenderer -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\contracts\src\PigeonPea.Game.Contracts\PigeonPea.Game.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\contracts\src\PigeonPea.Dungeon.Contracts\PigeonPea.Dungeon.Contracts.csproj" />

    <!-- Rendering contracts (IRenderer, IRenderTarget, Tile, Viewport, etc.) -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\contracts\src\PigeonPea.Rendering.Contracts\PigeonPea.Rendering.Contracts.csproj" />

    <!-- Scene Management Contracts -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\contracts\src\PigeonPea.Scene.Contracts\PigeonPea.Scene.Contracts.csproj" />

    <!-- Build inventory plugin so it copies into this console's plugins folder -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\plugins\src\PigeonPea.Plugins.Inventory.Basic\PigeonPea.Plugins.Inventory.Basic.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <ProjectReference Include="..\..\..\plugins\PigeonPea.Plugins.Hud.TerminalGui\PigeonPea.Plugins.Hud.TerminalGui.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <!-- ANSI terminal renderer backend (direct reference for backend detection) -->
    <ProjectReference Include="..\..\..\plugins\PigeonPea.Plugins.Rendering.Terminal.ANSI\PigeonPea.Plugins.Rendering.Terminal.ANSI.csproj" />

    <!-- Braille terminal renderer backend (direct reference for backend detection) -->
    <ProjectReference Include="..\..\..\plugins\PigeonPea.Plugins.Rendering.Terminal.Braille\PigeonPea.Plugins.Rendering.Terminal.Braille.csproj" />

    <!-- Modern Edgar Dungeon Generator Plugin -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\plugins\src\PigeonPea.Plugin.Dungeon.ModernEdgar\PigeonPea.Plugin.Dungeon.ModernEdgar.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <!-- Basic Dungeon Generator Plugin (Tier 3) -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\plugins\src\PigeonPea.Plugin.Dungeon.Basic\PigeonPea.Plugin.Dungeon.Basic.csproj" PrivateAssets="all" />

    <!-- Scene Manager Plugin (build-time, runtime via plugin system) -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\plugins\src\PigeonPea.Plugin.Scene.Manager\PigeonPea.Plugin.Scene.Manager.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <!-- Dungeon Renderer Plugin (Tier 3) -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\plugins\src\PigeonPea.Plugin.Dungeon.Rendering\PigeonPea.Plugin.Dungeon.Rendering.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />

    <!-- Game-level inventory ECS components for testing inventory service calls -->
    <ProjectReference Include="..\..\..\..\..\..\..\dotnet\game-essential\core\src\PigeonPea.Game.Items\PigeonPea.Game.Items.csproj" />

    <!-- Dungeon generation core (IDungeonGenerator, Basic/ModernEdgar implementations) -->
    <!-- REMOVED: PigeonPea.Dungeon.Core reference -->
  </ItemGroup>

  <ItemGroup>
    <!-- Temporarily exclude dungeon/map HUD views so we can focus on plugin loading -->
    <Compile Remove="TerminalHudApplication.cs" />
    <Compile Remove="Views\BrailleMapPanelView.cs" />
    <Compile Remove="Views\MapPanelView.cs" />
    <Compile Remove="Views\PixelMapPanelView.cs" />
    <Compile Remove="Views\DungeonPanelView.cs" />
    <!-- Exclude legacy renderer adapter (replaced by backend architecture) -->
    <Compile Remove="RendererAdapter.cs" />
  </ItemGroup>

  <Target Name="AddPluginsToPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <PluginsFiles Include="$(TargetDir)plugins\**\*.*" />
      <ResolvedFileToPublish Include="@(PluginsFiles)">
        <RelativePath>plugins\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
