<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="PigeonPea.Plugins.UI.Windows.AvaloniaHUD.Controls.GameHUD">

  <Design.DataContext>
    <vm:HudViewModel xmlns:vm="clr-namespace:PigeonPea.Plugins.UI.Windows.AvaloniaHUD.ViewModels"/>
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="GameHUD">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector="HealthBar">
      <Setter Property="Background" Value="#FF3B3B3"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="10"/>
    </Style>

    <Style Selector="NotificationItem">
      <Setter Property="Background" Value="#CC000000"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="PanelToggle">
      <Setter Property="Background" Value="#CC333333"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar: Health, Level, Gold -->
    <Grid Grid.Row="0" Margin="10,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Player Info Panel -->
      <Border Grid.Column="0" Background="#CC222222" CornerRadius="8" Padding="12,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Level -->
          <StackPanel Grid.Column="0" Margin="0,0,10,0" Orientation="Horizontal">
            <TextBlock Text="Lv." Foreground="#FFD700" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="{Binding PlayerLevel}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="4,0,0,0"/>
          </StackPanel>

          <!-- Player Name (placeholder) -->
          <TextBlock Grid.Column="1" Text="Hero" Foreground="White" FontSize="16" FontWeight="Bold"
                     VerticalAlignment="Center" HorizontalAlignment="Center"/>

          <!-- Gold -->
          <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
            <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PlayerGold}" Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="2,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Health Bar -->
      <ProgressBar Grid.Column="1" Classes="HealthBar" Width="200" Value="{Binding HealthPercentage}"
                    Maximum="100" Margin="10,0"/>

      <!-- Quick Actions -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
        <Button Classes="PanelToggle" Content="🎒" ToolTip.Tip="Inventory"
                Command="{Binding ToggleInventory}" Width="32" Height="32"/>
        <Button Classes="PanelToggle" Content="👤" ToolTip.Tip="Character"
                Command="{Binding ToggleCharacter}" Width="32" Height="32" Margin="2,0,0,0"/>
        <Button Classes="PanelToggle" Content="🗺" ToolTip.Tip="Minimap"
                Command="{Binding ToggleMinimap}" Width="32" Height="32" Margin="2,0,0,0"/>
        <Button Classes="PanelToggle" Content="🐛" ToolTip.Tip="Debug"
                Command="{Binding ToggleDebug}" Width="32" Height="32" Margin="2,0,0,0"/>
      </StackPanel>

      <!-- Experience Bar -->
      <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="EXP" Foreground="#607D8B" FontSize="10" FontWeight="Bold"/>
        <ProgressBar Width="120" Value="{Binding ExperiencePercentage}" Maximum="100"
                     Height="8" Margin="0,2,0,0" Foreground="#607D8B" Background="#CC1A1A1A"/>
      </StackPanel>
    </Grid>

    <!-- Main Content Area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="200"/>
      </Grid.ColumnDefinitions>

      <!-- Game World Area (for future expansion) -->
      <Border Grid.Column="0" Background="#CC0A0A0A" CornerRadius="8" Margin="10,5">
        <TextBlock Text="Game World Area" Foreground="#9E9E9E" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <!-- Side Panel -->
      <StackPanel Grid.Column="1" Margin="0,5,10,5">
        <!-- Location Info -->
        <Border Background="#CC1F2937" CornerRadius="4" Padding="8,4" Margin="0,0,0,5">
          <StackPanel>
            <TextBlock Text="📍 Location" Foreground="White" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentLocation}" Foreground="#FFD700" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <!-- Current Quest -->
        <Border Background="#CC795548" CornerRadius="4" Padding="8,4" Margin="0,0,0,5"
                IsVisible="{Binding CurrentQuest, Converter={x:Static StringConverters.IsNotNullToVisible}}">
          <StackPanel>
            <TextBlock Text="📜 Quest" Foreground="White" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentQuest}" Foreground="#FFD700" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>

        <!-- Debug Info (when visible) -->
        <Border Background="#CC9E9E9E" CornerRadius="4" Padding="8,4" Margin="0,0,0,5"
                IsVisible="{Binding IsDebugVisible}">
          <StackPanel>
            <TextBlock Text="🐛 Debug Info" Foreground="White" FontSize="12" FontWeight="Bold"/>
            <TextBlock Text="FPS: 60" Foreground="#00BCD4" FontSize="10" Margin="0,2,0,0"/>
            <TextBlock Text="Memory: 128MB" Foreground="#00BCD4" FontSize="10" Margin="0,1,0,0"/>
            <TextBlock Text="Objects: 1,247" Foreground="#00BCD4" FontSize="10" Margin="0,1,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Notification Area -->
    <ItemsControl Grid.Row="2" Items="{Binding Notifications}" Margin="10,5">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="NotificationItem" Opacity="0.9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Icon based on type -->
              <TextBlock Grid.Column="0" Text="{Binding Type, Converter={x:Static NotificationTypeConverters.TypeToIcon}}"
                         FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

              <!-- Message -->
              <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="White" FontSize="12"
                         VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>

              <!-- Close button -->
              <Button Grid.Column="2" Content="✕" Foreground="White" Background="Transparent"
                      BorderThickness="0" Padding="4" FontSize="12"
                      Command="{Binding $parent[DataContext].RemoveNotification,
                                CommandParameter={Binding Id}}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </Grid>

</UserControl>
