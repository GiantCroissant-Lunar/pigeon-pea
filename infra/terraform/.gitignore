# Terraform-specific ignores

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contain secrets)
*.tfvars
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock files (commit this for version consistency)
# .terraform.lock.hcl

# Terraform Cloud / Enterprise
.terraform.d/

# Module cache
.terraform-cache/

# Sensitive data
secrets/
*.secret
*.key
*.pem

# OS-specific
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
